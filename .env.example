# Server-only (no NEXT_PUBLIC_ prefix, never sent to the browser).
# Copy to .env.local. If N8N_WEBHOOK_URL is unset, run logging is skipped.
N8N_WEBHOOK_URL=https://your-n8n.example.com/webhook/geo-compare-run
# Must match the Header Auth credential on the n8n Webhook node (header name: X-Geo-Secret).
N8N_WEBHOOK_SECRET=
